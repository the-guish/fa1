{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FA1",
  "version": "0.1.0",
  "identifier": "dev.fa1.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "FA1",
        "width": 900,
        "height": 720
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.png"]
  }
}
